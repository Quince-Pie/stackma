  "observations": {
    "openerAndProvenance": "Chromium 154 probe: Ctrl+T and tabs.duplicate report openerTabId = active tab with no navigation-target event; target=_blank, rel=noreferrer/opener, window.open (+noopener), iframe links, middle-click and Ctrl+click emit onCreatedNavigationTarget with the source tab and no windowId.",
    "eventOrder": "60/60 probe groups: tabGroups.onCreated delivered before tabs.group resolved (Chromium 154).",
    "errors": {
      "tabsGet": "No tab with id: 987654.",
      "tabGroupsGet": "No group with id: 987654."
    },
    "incognito": "Spanning worker groups incognito tabs with explicit windowId or groupId while a normal window is focused; default current window fails with 'Tabs can only be moved between windows in the same profile.'"
  },
