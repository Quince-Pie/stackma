{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "NodeNext",
    "lib": ["ES2024", "DOM"],
    "types": ["firefox-webext-browser"],
    "rootDirs": ["extension", "chrome/extension"],
    "skipLibCheck": true
  },
  "include": ["extension/**/*.js", "chrome/extension/**/*.js"]
}
