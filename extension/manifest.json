{
  "manifest_version": 3,
  "name": "Tab Gantry",
  "version": "1.1.10",
  "description": "Automatically stack new related tabs in Firefox\u2019s native tab groups. Preserve pinned tabs and separate windows.",
  "permissions": [
    "webNavigation",
    "tabGroups",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Tab Gantry - Automatic Tab Groups",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stackma@extensions.local",
      "strict_min_version": "156.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}